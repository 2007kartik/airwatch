# ============================================================
# AirWatch — Environment Variables Example
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.
# ============================================================

# --- Database ---
# Local PostgreSQL 18 (port 5433) — recommended for this machine:
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5433/airwatch

# Local PostgreSQL 16 (port 5432) alternative:
# DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/airwatch

# Docker PostgreSQL alternative (requires Docker Desktop running):
# DATABASE_URL=postgresql+psycopg://airwatch_user:change_me@localhost:5432/airwatch

# --- FastAPI / Application ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# --- Alert Thresholds (demo/configurable thresholds --- not regulatory advice) ---
THRESHOLD_TEMP_WARNING=35.0
THRESHOLD_TEMP_CRITICAL=40.0
THRESHOLD_HUMIDITY_WARNING=80.0
THRESHOLD_HUMIDITY_CRITICAL=90.0
THRESHOLD_GAS_WARNING=300.0
THRESHOLD_GAS_CRITICAL=500.0
THRESHOLD_PM25_WARNING=35.4
THRESHOLD_PM25_CRITICAL=55.4
THRESHOLD_PM10_WARNING=154.0
THRESHOLD_PM10_CRITICAL=254.0

# --- Simulator ---
SIMULATOR_API_URL=http://localhost:8000
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_SPIKE_PROBABILITY=0.05
