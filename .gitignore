# ============================================================
# AirWatch — .gitignore
# ============================================================

# --- Environment / Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# --- Virtual Environments ---
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# --- Alembic ---
alembic/versions/__pycache__/

# --- Node / React ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Build output ---
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# --- IDE and editor files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml
docker-compose.local.yml

# --- Misc ---
*.bak
*.tmp
